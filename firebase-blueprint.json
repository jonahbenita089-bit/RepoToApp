{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile with optional contact email and phone number.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document owner."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the RepoForge account header."
        },
        "preferredContactType": {
          "type": "string",
          "enum": ["GOOGLE", "EMAIL", "PHONE"],
          "description": "Primary contact method chosen during account setup."
        },
        "contactEmail": {
          "type": "string",
          "description": "Optional contact email address associated with the user account."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Optional phone number associated with the user account."
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional Google profile avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp() at creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated via FieldValue.serverTimestamp() on edits."
        }
      },
      "required": [
        "userId",
        "displayName",
        "preferredContactType",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudSavedRepo": {
      "title": "CloudSavedRepo",
      "description": "GitHub repository bookmarked and synced across devices for the signed-in user.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Canonical owner/repo GitHub slug."
        },
        "owner": {
          "type": "string",
          "description": "GitHub repository owner login."
        },
        "repo": {
          "type": "string",
          "description": "GitHub repository name."
        },
        "description": {
          "type": "string",
          "description": "Repository description summary."
        },
        "defaultBranch": {
          "type": "string",
          "description": "Default Git branch name."
        },
        "detectedStack": {
          "type": "string",
          "description": "Detected mobile framework enum name."
        },
        "avatarUrl": {
          "type": "string",
          "description": "Owner avatar image URL."
        },
        "htmlUrl": {
          "type": "string",
          "description": "Web URL to the GitHub repository."
        },
        "supportsApk": {
          "type": "boolean",
          "description": "Whether Android APK output is supported."
        },
        "supportsIpa": {
          "type": "boolean",
          "description": "Whether iOS IPA output is supported."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "fullName",
        "owner",
        "repo",
        "description",
        "defaultBranch",
        "detectedStack",
        "avatarUrl",
        "htmlUrl",
        "supportsApk",
        "supportsIpa",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private per-user account profile including contact email and phone number."
    },
    "/users/{userId}/saved_repos/{repoId}": {
      "schema": {
        "$ref": "#/entities/CloudSavedRepo"
      },
      "description": "Per-user cloud-synced GitHub repository bookmarks."
    }
  }
}
